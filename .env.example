APP_ENV=development
LOG_LEVEL=INFO

# ── Ingesta (decisión #1) ─────────────────────────────────────
INGEST_MODE=api                  # api | postgres

# Opción A (postgres): Railway Postgres vía túnel SSH local (puerto 55432)
#   ssh -i $env:USERPROFILE\.ssh\id_ed25519_railway -o IdentitiesOnly=yes -N -L 55432:localhost:5432 railway-postgres
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:55432/railway

# Opción B (api) — DOD HU 0.3: ".env.example con DATABASE_URL o API_URL"
API_URL=https://api-production-78ee.up.railway.app/api/v1
API_KEY=

# ── FX (HU 3.1) ──────────────────────────────────────────────
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=
FX_RATE_TYPE=oficial             # oficial | paralelo

# ── Scraping ─────────────────────────────────────────────────
DOWNLOAD_DELAY=1.5
COLLECTION_MAX_RETRIES=2
